{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "appearanceTools": false,
        "color": {
            "background": false,
            "button": false,
            "caption": false,
            "custom": false,
            "customDuotone": false,
            "customGradient": false,
            "defaultDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "gradient": false,
            "heading": false,
            "link": false,
            "text": false,
            "palette": [
                {
                    "name": "Primär Blau",
                    "slug": "primary",
                    "color": "#1976B0"
                },
                {
                    "name": "Akzent Grün",
                    "slug": "secondary",
                    "color": "#7AB32E"
                },
                {
                    "name": "Hintergrund",
                    "slug": "background",
                    "color": "#E5F3F9"
                },
                {
                    "name": "Weiß",
                    "slug": "white",
                    "color": "#ffffff"
                },
                {
                    "name": "Dunkel",
                    "slug": "dark",
                    "color": "#2C2C2C"
                }
            ]
        },
        "typography": {
            "customFontSize": false,
            "dropCap": false,
            "fontStyle": false,
            "fontWeight": false,
            "letterSpacing": false,
            "lineHeight": false,
            "textColumns": false,
            "textDecoration": false,
            "textTransform": false,
            "writingMode": false,
            "fontFamilies": [
                {
                    "name": "Nunito Sans",
                    "slug": "nunito-sans",
                    "fontFamily": "'Nunito Sans', sans-serif"
                }
            ]
        },
        "spacing": {
            "blockGap": false,
            "margin": false,
            "padding": false
        },
        "layout": {
            "contentSize": "1200px",
            "wideSize": "1400px"
        },
        "blocks": {
            "core/separator": {
                "color": {
                    "background": false,
                    "text": false
                }
            }
        }
    },
    "styles": {
        "blocks": {
            "core/separator": {
                "border": {
                    "top": {
                        "width": "0px",
                        "style": "none"
                    }
                }
            }
        }
    }
}